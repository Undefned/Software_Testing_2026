<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ru.itmo</groupId>
    <artifactId>selenium-tests</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <selenium.version>4.24.0</selenium.version>
        <junit.version>5.10.3</junit.version>
        <!--
            По умолчанию все браузеры (Chrome и Firefox, при параллельном прогоне — оба сразу)
            запускаются БЕЗ видимого окна. Это единственное, что меняет "пиздец из окон" на
            тихий фон: сами тесты, параллельность и покрытие остаются прежними.
            Хотите посмотреть глазами (например, отлаживая E2E-03) — переопределите флаг:
                mvn test -Dheadless=false
        -->
        <headless>true</headless>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            Явная зависимость на launcher нужна, чтобы surefire надёжно подхватывал
            junit-platform.properties (парал. выполнение, thread pool) во всех версиях
            плагина, а не полагался на транзитивное разрешение.
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.10.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
            <version>1.2.17</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!--
                        Surefire форкает отдельный JVM-процесс под тесты — без явной передачи
                        сюда системное свойство "headless" из <properties> само по себе внутрь
                        не долетит. -Dheadless=... и -Dbrowser=..., переданные прямо в командной
                        строке mvn, форкнутый процесс видит и так (Maven пробрасывает их
                        автоматически), поэтому явно пробрасываем только headless — как значение
                        по умолчанию, которое CLI-флаг всё равно перекрывает.
                    -->
                    <systemPropertyVariables>
                        <headless>${headless}</headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
